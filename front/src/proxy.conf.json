{
    "/githubAPI/users/*": {
        "target": " https://api.github.com/users/",
        "secure": false,
        "changeOrigin": true,
        "pathRewrite": {
            "^/githubAPI/users/": ""
        }
    },
    "/githubAPI/repos/*": {
        "target": " https://api.github.com/repos/",
        "secure": false,
        "changeOrigin": true,
        "pathRewrite": {
            "^/githubAPI/repos/": ""
        }
    }
}